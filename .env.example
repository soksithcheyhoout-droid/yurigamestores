# Cheydev TopUp MySQL Database & Backend Server Config
PORT=5001
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cheydev_topup_db

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# PayLinkAPI Dual-Rail Gateway (Bakong KHQR + ABA PayWay)
PAYLINK_API_URL=https://paylinkapi-bot.onrender.com
PAYLINK_API_KEY=your-paylink-api-key
PAYLINK_SECRET=your-paylink-secret
PAYLINK_STORE_NAME=topup
PAYLINK_BAKONG_ACCOUNT=your_bakong_account@aclb
PAYLINK_ABA_USD_LINK=https://link.payway.com.kh/ABAPAY...
PAYLINK_ABA_KHR_LINK=https://link.payway.com.kh/ABAPAY...


# Game top-up provider API — Bay2Game (server-side only; never prefix this key with VITE_)
# Used for Mobile Legends (ml), Free Fire (ff) and RoS Legacy (roslegacy).
BAY2GAME_BASE_URL=https://api.bay2game.xyz/api
BAY2GAME_API_KEY=your-bay2game-api-key

# Free Fire player-name lookup (server-side only). Shows the real in-game account name when a
# customer enters their Free Fire ID. Get a FREE key (100 requests/hour) in ~60 seconds at
# https://developers.freefirecommunity.com — no card required. If unset, the ID is still accepted
# (format-checked) so sales are never blocked, but the real name will not be shown.
FREEFIRE_API_KEY=your-freefirecommunity-api-key

# Legacy SoraTopup provider (server-side only) — still used for Roblox (robuxsend), which Bay2Game does not sell.
SORATOPUP_BASE_URL=https://app.soratopup.com/api/v1
SORATOPUP_API_KEY=your-soratopup-api-key

# Internal storefront game codes (mapped to provider codes in server/services/soratopup.js)
SORATOPUP_GAME_CODES=roslegacy,ml,ff,robuxsend

# RoS Angkor direct top-up provider (server-side only; never prefix with VITE_).
# Requests go out through a STATIC-IP proxy so RoS Angkor sees an allowlisted egress IP.
ROSANGKOR_API_KEY=your-rosangkor-api-key
ROSANGKOR_BASE_URL=https://api.rosangkor.com/v1
ROSANGKOR_PROXY_URL=http://user:pass@proxy-host:port

# Telegram admin integration (server-side only; never prefix with VITE_)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ADMIN_1=your-primary-admin-chat-id
TELEGRAM_ADMIN_2=your-secondary-admin-chat-id
TELEGRAM_GROUP_ID=your-admin-supergroup-id

# Optional test/process controls
TELEGRAM_POLLING_DISABLED=false
SORA_STARTUP_SYNC_DISABLED=false

# Reverse proxy and application abuse limits
# Keep at 1 for one trusted proxy/CDN hop; set to your actual proxy chain.
TRUST_PROXY_HOPS=1
API_RATE_LIMIT_PER_MINUTE=300
API_MUTATION_LIMIT_PER_MINUTE=90
API_MAX_CONCURRENT_PER_IP=24
API_MAX_CONCURRENT_GLOBAL=600
AUTH_RATE_LIMIT_PER_15_MINUTES=20
ADMIN_AUTH_RATE_LIMIT_PER_15_MINUTES=10
PLAYER_VERIFY_LIMIT_PER_MINUTE=15
ORDER_LOOKUP_LIMIT_PER_MINUTE=30
PAYMENT_CREATE_LIMIT_PER_MINUTE=15
PAYMENT_STATUS_LIMIT_PER_MINUTE=180
ADMIN_OTP_GLOBAL_LIMIT_PER_15_MINUTES=30